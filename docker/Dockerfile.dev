
ARG BASE="ubuntu:20.04"
FROM $BASE
ENV DEBIAN_FRONTEND=noninteractive

RUN CUDA_DIR=$(ls -d /usr/local/cuda-[0-9]*.[0-9]* 2>/dev/null | sort -V | tail -n 1) \
    && CUDA_VERSION=$(echo "$CUDA_DIR" | sed -E 's/.*cuda-([0-9]+)\.([0-9]+).*/\1-\2/') \
    && apt-get update -y \
    && apt-get install -y vim git iproute2 wget curl python3-pip pkg-config \
        libboost-all-dev libudev-dev nasm yasm liblz4-dev libsqlite3-dev \
        zlib1g-dev libtcmalloc-minimal4 \
        uuid-dev libjson-c-dev \
        build-essential cmake \
        rdma-core libibverbs-dev librdmacm-dev libnuma-dev \
        $(apt-cache search "linux-headers-5.15.*-generic" | tail -n 1 | awk '{print $1}') \
        ${CUDA_VERSION:+cuda-nvml-dev-$CUDA_VERSION} \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Keep build inputs outside the bind-mounted source tree for offline rebuilds.
RUN mkdir -p /opt/iaxl-build-deps \
    && wget -q -O /opt/iaxl-build-deps/QAT20.L.1.2.30-00178.tar.gz \
        https://downloadmirror.intel.com/921047/QAT20.L.1.2.30-00178.tar.gz \
    && git clone --depth 1 --branch v1.9.0 https://github.com/intel/qpl.git /opt/iaxl-build-deps/qpl

# Own prefix: Ubuntu's libucx0 1.12 (a libboost-mpi/openmpi dependency) lives in
# /usr/lib/x86_64-linux-gnu and would shadow a UCX installed under /usr at runtime.
# ld.so.conf.d/ucx.conf sorts before x86_64-linux-gnu.conf, so this UCX wins.
RUN git clone https://github.com/openucx/ucx.git /opt/ucx && \
    cd /opt/ucx && git checkout v1.21.0 && \
    ./autogen.sh && \
    ./contrib/configure-release-mt \
        --prefix=/usr/local/ucx \
        --enable-shared --disable-static \
        --disable-doxygen-doc --enable-optimizations \
        --enable-cma --enable-devel-headers \
        --with-cuda=/usr/local/cuda \
        --with-verbs --with-dm && \
    make -j$(nproc) && make -j$(nproc) install-strip && \
    echo /usr/local/ucx/lib > /etc/ld.so.conf.d/ucx.conf && ldconfig
ENV PATH=/usr/local/ucx/bin:$PATH

RUN git clone https://github.com/ai-dynamo/nixl.git /opt/nixl && \
    cd /opt/nixl && \
    git checkout v1.2.0 && \
    meson setup build \
        -Ducx_path=/usr/local/ucx \
        -Dinstall_headers=true \
        -Denable_plugins=UCX \
        -Ddisable_gds_backend=true \
        -Dbuild_docs=false \
        --prefix=/usr/local && \
    cd build && ninja && ninja install && ldconfig

RUN echo "install idxd-config" \
    && git clone --depth 1 --branch stable https://github.com/intel/idxd-config.git /idxd-config \
    && cd /idxd-config \
    && ./autogen.sh \
    && ./configure CFLAGS='-g -O2' --prefix=/usr --sysconfdir=/etc --libdir=/usr/lib --disable-docs \
    && make install \
    && rm -rf /idxd-config

